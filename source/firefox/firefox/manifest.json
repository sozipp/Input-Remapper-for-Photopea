{
  "manifest_version": 3,
  "name": "Input Remapper for Photopea",
  "version": "3.1.0",
  "description": "Remap any key, mouse button or scroll gesture into Photopea's own shortcuts. Works only on photopea.com; your OS key stays untouched. Made by sozip19op - https://youtube.com/@sozip19op",
  "author": "sozip19op",
  "homepage_url": "https://youtube.com/@sozip19op",
  "browser_specific_settings": {
    "gecko": {
      "id": "photopea-input-remapper@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Input Remapper for Photopea",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://photopea.com/*",
        "https://www.photopea.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}